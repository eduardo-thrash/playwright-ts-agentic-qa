{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": [
        "src/pages/*"
      ],
      "@actions/*": [
        "src/actions/*"
      ],
      "@validations/*": [
        "src/validations/*"
      ],
      "@fixtures/*": [
        "src/fixtures/*"
      ],
      "@helpers/*": [
        "src/helpers/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "playwright.config.ts"
  ]
}